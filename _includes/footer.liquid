{% comment %}
  Set `enable_footer: false` in _config.yml to hide the footer bar entirely.
  The layouts also add the `sticky-bottom-footer` body class in that case, which
  drops the 70px of body padding that exists only to clear the fixed footer.
{% endcomment %}
{% unless site.enable_footer == false %}
  {% capture footer_contents %}
    &copy; Copyright {{ site.time | date: '%Y' }}
    {{ site.first_name }}
    {{ site.middle_name }}
    {{ site.last_name }}. {{ site.footer_text }}
    {% if site.impressum_path %}
      <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
    {% endif %}
    {% if site.last_updated %}
      Last updated: {{ 'now' | date: '%B %d, %Y' }}.
    {% endif %}
  {% endcapture %}

  {% if site.footer_fixed %}
    <footer class="fixed-bottom" role="contentinfo">
      <div class="container mt-0">
        {{ footer_contents }}
      </div>
    </footer>
  {% else %}
    <footer class="sticky-bottom mt-5" role="contentinfo">
      {% if site.newsletter.enabled %}
        {% include newsletter.liquid %}
      {% endif %}

      <div class="container">
        {{ footer_contents }}
      </div>
    </footer>
  {% endif %}
{% endunless %}
