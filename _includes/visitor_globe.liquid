{% comment %}
  Visitor globe shown at the bottom of the about page.
  Configured via the `visitor_globe` block in _config.yml.

  provider: custom        -- emits `visitor_globe.snippet` verbatim. Use this with
                             whatever snippet your widget provider hands you; it is
                             immune to any change in their URL format.
  provider: mapmyvisitors -- builds the URL from `visitor_globe.id`, i.e. the value
                             of `d=` in the snippet you get from
                             https://mapmyvisitors.com/add (pick a Globe widget).
{% endcomment %}

{% assign vg = site.visitor_globe %}
{% if vg and vg.enabled %}
  <div class="visitor-globe">
    {% if vg.title %}
      <h2>{{ vg.title }}</h2>
    {% endif %}
    <div class="visitor-globe-widget" style="max-width: {{ vg.width | default: 300 }}px">
      {% case vg.provider %}
        {% when 'mapmyvisitors' %}
          <!-- the `mmvst_globe` id is what the widget script looks for to inject itself; do not rename it -->
          <script type="text/javascript" id="mmvst_globe" src="//mapmyvisitors.com/globe.js?d={{ vg.id }}"></script>
        {% when 'custom' %}
          {{ vg.snippet }}
        {% else %}
          <!-- visitor_globe.provider must be either 'mapmyvisitors' or 'custom' -->
      {% endcase %}
    </div>
    {% if vg.caption %}
      <p class="visitor-globe-caption">{{ vg.caption }}</p>
    {% endif %}
  </div>
{% endif %}
